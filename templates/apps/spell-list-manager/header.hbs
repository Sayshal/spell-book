<header class="spell-book-header">
  <i class="fas fa-bars-progress header-icon" aria-hidden="true"></i>
  <span class="header-title">{{localize "SPELLBOOK.Manager.Application.Title"}}</span>
  {{> "modules/spell-book/templates/components/detach-button.hbs" buttonClass="detach-btn"}}
  <button type="button" class="close-btn" data-action="closeManager"
    data-tooltip="{{localize 'APPLICATION.ACTIONS.Close'}}">
    <i class="fas fa-times" aria-hidden="true"></i>
  </button>
</header>
