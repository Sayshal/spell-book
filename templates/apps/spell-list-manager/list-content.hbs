<section class="selected-list-content" role="main">
  {{#if selectedList}}
    <div class="selected-list-header">
      <div class="header-title">
        <h2>{{selectedList.name}}</h2>
      </div>
      <div class="header-buttons" role="toolbar">
        <div class="registry-toggle action-button" data-tooltip="{{localize 'SPELLBOOK.Registry.ToggleTooltip'}}">
          <label class="checkbox-label">
            <dnd5e-checkbox data-action="registerList" data-uuid="{{selectedList.uuid}}"
              {{#if selectedList.isRegistryEnabled}}checked{{/if}}></dnd5e-checkbox>
            <span>{{localize 'SPELLBOOK.Registry.EnableLabel'}}</span>
          </label>
        </div>
        {{#if selectedList.isRenameable}}
          <button type="button" class="action-button" data-action="renameList" data-uuid="{{selectedList.uuid}}"
            data-tooltip="{{localize 'SPELLBOOK.Manager.Tooltips.Rename'}}">
            <i class="fas fa-pen" aria-hidden="true"></i>
          </button>
        {{/if}}
        {{#if selectedList.isPlayerSpellbook}}
          <button type="button" class="action-button" data-action="openActor"
            data-tooltip="{{localize 'ATLAS.Common.OpenActor'}}">
            <i class="fas fa-user" aria-hidden="true"></i>
          </button>
        {{/if}}
        {{#if selectedList.isClassSpellList}}
          <button type="button" class="action-button" data-action="openClass"
            data-tooltip="{{localize 'SPELLBOOK.Manager.Buttons.Open' type=selectedList.classType}}">
            <i class="fas fa-scroll" aria-hidden="true"></i>
          </button>
        {{/if}}
        {{#if selectedList.canRestore}}
          <button type="button" class="action-button" data-action="restoreList" data-uuid="{{selectedList.uuid}}"
            data-tooltip="{{localize 'SPELLBOOK.Manager.Buttons.Restore'}}">
            <i class="fas fa-sync" aria-hidden="true"></i>
          </button>
        {{/if}}
        <button type="button" class="action-button" data-action="deleteList" data-uuid="{{selectedList.uuid}}"
          data-tooltip="{{localize 'SPELLBOOK.Manager.Buttons.Delete'}}">
          <i class="fas fa-trash" aria-hidden="true"></i>
        </button>
        <button type="button" class="action-button save-btn" data-action="saveList" data-uuid="{{selectedList.uuid}}"
          data-tooltip="{{localize 'ATLAS.Common.Save'}}">
          <i class="fas fa-save" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <div class="split-view">
      <div class="available-spells-panel">
        <h3 class="panel-header">{{localize "SPELLBOOK.Manager.Sidebar.AvailableSpells"}}
          {{#if filteredSpells}}({{filteredSpells.totalFiltered}}){{/if}}
        </h3>
        <div class="panel-scroll">
          {{#if filteredSpells.spells.length}}
            <ul class="spell-list-items" role="list">
              {{#each filteredSpells.spells as |spell|}}
                <li
                  class="spell-item available{{#if ../selectionMode}} selectable{{/if}}{{#if spell.isSelectedForAdd}} selected{{/if}}"
                  data-uuid="{{spell.uuid}}" draggable="true">
                  <div class="spell-name">
                    {{{spell.enrichedIcon}}}
                    <div class="name-stacked">
                      <span class="title">{{spell.name}}</span>
                      <span class="subtitle">{{spell.formattedDetails}}</span>
                    </div>
                  </div>
                  {{#if spell.showCompare}}
                    <i class="fa-solid fa-scale-balanced spell-compare-icon{{#if spell.isInComparison}} active{{/if}}"
                      data-action="compareSpell" data-uuid="{{spell.uuid}}"
                      data-tooltip="{{localize 'SPELLBOOK.Comparison.CompareSpell' name=spell.name}}"
                      aria-label="{{localize 'SPELLBOOK.Comparison.CompareSpell' name=spell.name}}"></i>
                  {{/if}}
                  <button type="button" class="add-spell{{#if ../selectionMode}} select-toggle{{/if}}"
                    data-action="addSpell" data-uuid="{{spell.uuid}}"
                    data-tooltip="{{localize 'SPELLBOOK.Manager.Buttons.AddSpell' name=spell.name}}">
                    {{#if ../selectionMode}}
                      <i class="fas fa-{{#if spell.isSelectedForAdd}}check-square{{else}}square{{/if}}"
                        aria-hidden="true"></i>
                    {{else}}
                      <i class="fas fa-plus" aria-hidden="true"></i>
                    {{/if}}
                  </button>
                </li>
              {{/each}}
            </ul>
          {{else}}
            {{> "modules/spell-book/templates/components/empty-state.hbs" message=(localize "SPELLBOOK.Manager.Columns.NoMatchingSpells")}}
          {{/if}}
        </div>
      </div>
      <div class="current-list-panel">
        <h3 class="panel-header">{{selectedList.name}} ({{selectedList.spellCount}})</h3>
        <div class="panel-scroll">
          {{#if selectedList.spells.length}}
            {{#each selectedList.spellsByLevel as |levelData|}}
              <div class="spell-level" data-level="{{levelData.level}}">
                <h4 class="spell-level-heading" data-action="toggleSpellHeader" data-level="{{levelData.level}}"
                  role="button" aria-expanded="true">
                  <i class="fas fa-caret-down collapse-indicator" aria-hidden="true"></i>
                  {{levelData.levelName}}
                </h4>
                <ul class="spell-list" role="list">
                  {{#each levelData.spells as |spell|}}
                    <li
                      class="spell-item{{#if @root.selectionMode}} selectable{{/if}}{{#if spell.isSelectedForRemoval}} selected{{/if}}"
                      data-uuid="{{spell.uuid}}" draggable="true">
                      <div class="spell-name">
                        {{{spell.enrichedIcon}}}
                        <div class="name-stacked">
                          <span class="title">{{spell.name}}</span>
                          <span class="subtitle">{{spell.formattedDetails}}</span>
                        </div>
                      </div>
                      {{#if spell.showCompare}}
                        <i class="fa-solid fa-scale-balanced spell-compare-icon{{#if spell.isInComparison}} active{{/if}}"
                          data-action="compareSpell" data-uuid="{{spell.uuid}}"
                          data-tooltip="{{localize 'SPELLBOOK.Comparison.CompareSpell' name=spell.name}}"
                          aria-label="{{localize 'SPELLBOOK.Comparison.CompareSpell' name=spell.name}}"></i>
                      {{/if}}
                      <button type="button" class="remove-spell{{#if @root.selectionMode}} select-toggle{{/if}}"
                        data-action="removeSpell" data-uuid="{{spell.uuid}}"
                        data-tooltip="{{localize 'SPELLBOOK.Manager.Buttons.RemoveSpell' name=spell.name}}">
                        {{#if @root.selectionMode}}
                          <i class="fas fa-{{#if spell.isSelectedForRemoval}}check-square{{else}}square{{/if}}"
                            aria-hidden="true"></i>
                        {{else}}
                          <i class="fas fa-trash" aria-hidden="true"></i>
                        {{/if}}
                      </button>
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{/each}}
          {{else}}
            {{> "modules/spell-book/templates/components/empty-state.hbs" message=(localize "SPELLBOOK.Manager.Columns.NoSpells")}}
          {{/if}}
        </div>
      </div>
    </div>
  {{else if spellFirst}}
    <div class="selected-list-header">
      <div class="header-title">
        <h2>{{localize "SPELLBOOK.Manager.SpellFirst.Title"}}</h2>
      </div>
      <div class="header-buttons" role="toolbar">
        <button type="button" class="action-button" data-action="applySpellLists"
          {{#unless spellFirst.canApply}}disabled{{/unless}}
          data-tooltip="{{localize 'SPELLBOOK.Manager.SpellFirst.ApplyHint'}}">
          <i class="fas fa-save" aria-hidden="true"></i> {{localize "SPELLBOOK.Manager.SpellFirst.Apply"}}
        </button>
      </div>
    </div>
    <div class="split-view">
      <div class="available-spells-panel">
        <h3 class="panel-header">{{localize "SPELLBOOK.Manager.Sidebar.AvailableSpells"}}
          ({{filteredSpells.totalFiltered}})</h3>
        <div class="panel-scroll">
          {{#if filteredSpells.spells.length}}
            <ul class="spell-list-items" role="list">
              {{#each filteredSpells.spells as |spell|}}
                <li class="spell-item available selectable{{#if spell.isSelectedForAdd}} selected{{/if}}"
                  data-uuid="{{spell.uuid}}">
                  <div class="spell-name">
                    {{{spell.enrichedIcon}}}
                    <div class="name-stacked">
                      <span class="title">{{spell.name}}</span>
                      <span class="subtitle">{{spell.formattedDetails}}</span>
                    </div>
                  </div>
                  <span class="spell-list-count"
                    data-tooltip="{{localize 'SPELLBOOK.Manager.SpellFirst.OnLists' count=spell.listCount}}">{{spell.listCount}}</span>
                  <button type="button" class="add-spell select-toggle" data-action="selectSpellForLists"
                    data-uuid="{{spell.uuid}}"
                    data-tooltip="{{localize 'SPELLBOOK.Manager.SpellFirst.SelectSpell' name=spell.name}}">
                    <i class="{{#if spell.isSelectedForAdd}}fa-solid fa-square-check{{else}}fa-regular fa-square{{/if}}"
                      aria-hidden="true"></i>
                  </button>
                </li>
              {{/each}}
            </ul>
          {{else}}
            {{> "modules/spell-book/templates/components/empty-state.hbs" message=(localize "SPELLBOOK.Manager.Columns.NoMatchingSpells")}}
          {{/if}}
        </div>
      </div>
      <div class="current-list-panel">
        <h3 class="panel-header">{{localize "SPELLBOOK.Manager.Columns.SpellLists"}} ({{spellFirst.listCount}})</h3>
        <div class="panel-scroll">
          {{#unless spellFirst.selectedCount}}
            <p class="spell-first-hint">{{localize "SPELLBOOK.Manager.SpellFirst.NoSpellSelected"}}</p>
          {{/unless}}
          {{#if spellFirst.lists.length}}
            <ul class="spell-list spell-first-list{{#unless spellFirst.selectedCount}} is-inert{{/unless}}" role="list">
              {{#each spellFirst.lists as |list|}}
                <li class="spell-item spell-first-target{{#if list.isTargeted}} selected{{/if}}"
                  data-uuid="{{list.uuid}}">
                  <button type="button" class="select-toggle" data-action="toggleSpellListTarget"
                    data-uuid="{{list.uuid}}" aria-pressed="{{#if list.isTargeted}}true{{else}}false{{/if}}"
                    {{#unless @root.spellFirst.selectedCount}}disabled{{/unless}}>
                    <i class="{{#if list.isTargeted}}fa-solid fa-square-check{{else}}{{#if list.isPartial}}fa-solid fa-square-minus{{else}}fa-regular fa-square{{/if}}{{/if}}"
                      aria-hidden="true"></i>
                  </button>
                  <div class="spell-name">
                    <div class="name-stacked">
                      <span class="title">{{list.name}}</span>
                      <span
                        class="subtitle">{{localize "SPELLBOOK.Manager.ListTooltip.SpellCount" count=list.count}}</span>
                    </div>
                  </div>
                  <i class="{{list.icon}} spell-first-kind-icon" aria-hidden="true"
                    data-tooltip="{{list.iconTooltip}}"></i>
                </li>
              {{/each}}
            </ul>
          {{else}}
            {{> "modules/spell-book/templates/components/empty-state.hbs" message=(localize "SPELLBOOK.Manager.SpellFirst.NoLists")}}
          {{/if}}
        </div>
      </div>
    </div>
  {{else}}
    <div class="no-selection">
      <p>{{localize "SPELLBOOK.Manager.Columns.NoListSelected"}}</p>
    </div>
  {{/if}}
</section>
