<div class="details-customization-content">
  <div class="scroll-body">
    <fieldset data-section="player-ui">
      <legend>
        <span>{{localize "SPELLBOOK.Settings.DetailsCustomization.GroupLegend" scope=(localize "SPELLBOOK.Settings.DetailsCustomization.SpellBook") section=(localize "SPELLBOOK.Settings.DetailsCustomization.UIElements")}}</span>
        <label class="select-all-label">
          <input type="checkbox" class="select-all">
          {{localize "ATLAS.Common.SelectAll"}}
        </label>
      </legend>
      {{#each playerUI}}
        {{> "modules/spell-book/templates/components/setting-item.hbs" this}}
      {{/each}}
    </fieldset>
    <fieldset data-section="player-metadata">
      <legend>
        <span>{{localize "SPELLBOOK.Settings.DetailsCustomization.GroupLegend" scope=(localize "SPELLBOOK.Settings.DetailsCustomization.SpellBook") section=(localize "SPELLBOOK.Settings.DetailsCustomization.MetadataElements")}}</span>
        <label class="select-all-label">
          <input type="checkbox" class="select-all">
          {{localize "ATLAS.Common.SelectAll"}}
        </label>
      </legend>
      {{#each playerMetadata}}
        {{> "modules/spell-book/templates/components/setting-item.hbs" this}}
      {{/each}}
    </fieldset>
    {{#if isGM}}
      <fieldset data-section="gm-ui">
        <legend>
          <span>{{localize "SPELLBOOK.Settings.DetailsCustomization.GroupLegend" scope=(localize "SPELLBOOK.Settings.DetailsCustomization.SpellListManager") section=(localize "SPELLBOOK.Settings.DetailsCustomization.UIElements")}}</span>
          <label class="select-all-label">
            <input type="checkbox" class="select-all">
            {{localize "ATLAS.Common.SelectAll"}}
          </label>
        </legend>
        {{#each gmUI}}
          {{> "modules/spell-book/templates/components/setting-item.hbs" this}}
        {{/each}}
      </fieldset>
      <fieldset data-section="gm-metadata">
        <legend>
          <span>{{localize "SPELLBOOK.Settings.DetailsCustomization.GroupLegend" scope=(localize "SPELLBOOK.Settings.DetailsCustomization.SpellListManager") section=(localize "SPELLBOOK.Settings.DetailsCustomization.MetadataElements")}}</span>
          <label class="select-all-label">
            <input type="checkbox" class="select-all">
            {{localize "ATLAS.Common.SelectAll"}}
          </label>
        </legend>
        {{#each gmMetadata}}
          {{> "modules/spell-book/templates/components/setting-item.hbs" this}}
        {{/each}}
      </fieldset>
    {{/if}}
  </div>
  <footer class="form-footer">
    <button type="submit"><i class="fas fa-save" aria-hidden="true"></i> {{localize "ATLAS.Common.Save"}}</button>
  </footer>
</div>
