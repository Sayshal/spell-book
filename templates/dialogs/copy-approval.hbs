<form class="wizard-copy-approval">
  <p>{{localize 'SPELLBOOK.Approval.Prompt' actor=actorName spell=spell.name}}</p>
  <div class="copy-details">
    <div class="form-group">
      <label>{{localize 'ATLAS.Common.Cost'}}:</label>
      <div class="form-fields">
        <span>{{costText}}</span>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize 'SPELLBOOK.Wizard.TimeLabel'}}:</label>
      <div class="form-fields">
        <span>{{time}}</span>
      </div>
    </div>
  </div>
  <div class="form-group">
    <label for="copy-approval-skip">{{localize 'SPELLBOOK.Approval.SkipTime'}}</label>
    <div class="form-fields">
      <input id="copy-approval-skip" type="checkbox" name="skipTime">
    </div>
    <p class="hint">{{localize 'SPELLBOOK.Approval.SkipTimeHint'}}</p>
  </div>
</form>
