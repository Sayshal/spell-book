<div class="form-group">
  <label for="current-name">{{localize "SPELLBOOK.Manager.Rename.CurrentNameLabel"}}</label>
  <input type="text" id="current-name" name="currentName" value="{{currentName}}" readonly disabled>
</div>
<div class="form-group">
  <label for="new-name">{{localize "SPELLBOOK.Manager.Rename.NewNameLabel"}}</label>
  <input type="text" id="new-name" name="newName" value="{{currentName}}"
    placeholder="{{localize 'SPELLBOOK.Manager.Rename.NewNamePlaceholder'}}" maxlength="100" required>
</div>
<div class="form-group">
  <div class="validation-error" style="display: none;">
    <p class="error-message">{{localize "SPELLBOOK.Manager.Rename.ValidationError"}}</p>
  </div>
</div>
